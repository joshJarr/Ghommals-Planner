{
  "name": "osrs-planners",
  "version": "1.0.0",
  "description": "OSRS Planners monorepo: Ghommal's Planner (Combat Achievements) and Collector's Planner (Collection Log)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "joshJarr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joshJarr/Ghommals-Planner.git"
  },
  "bugs": {
    "url": "https://github.com/joshJarr/Ghommals-Planner/issues"
  },
  "homepage": "https://github.com/joshJarr/Ghommals-Planner#readme",
  "keywords": [
    "osrs",
    "old-school-runescape",
    "combat-achievements",
    "collection-log",
    "runeprofile",
    "runelite"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "node -e \"import('./lib/progress.mjs').then(m=>m.selfCheck()&&console.log('ok')); import('./lib/clog.mjs').then(m=>{if(m.gildedThreshold(1734)!==1550)throw Error('gilded'); console.log('clog ok')})\"",
    "server": "node server.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
